{
  "schema_version": 1,
  "features": [
    {
      "name": "reusable slots and unique ID index",
      "before": "ordered Vec binary search",
      "after": "HashMap average O(1) and bounded reusable slots; no stale ID aliasing",
      "measured_modes": [
        "lookup"
      ],
      "cost": "hash table memory and small-table slowdown; average rather than worst-case constant time"
    },
    {
      "name": "stable active/history chains",
      "before": "O(A) cancel retain and second per-quote retain",
      "after": "constant-link removal, O(log T) terminal insertion; no reorder",
      "measured_modes": [
        "cancel",
        "quote"
      ],
      "cost": "larger slot metadata; noncrossing synthetic quote case only"
    },
    {
      "name": "ordered terminal index",
      "before": "O(R) retain and index rebuild even zero removal",
      "after": "zero-removal O(1), k removals O(k log T), oldest submitted terminal semantics",
      "measured_modes": [
        "churn"
      ],
      "cost": "BTreeSet allocation/index update; no all-zero-allocation claim"
    },
    {
      "name": "portable economic snapshot and explicit orders view",
      "before": "borrowed contiguous slice and Vec clone",
      "after": "allocation-free ordered borrowed view; snapshot still full sorted Vec; ID corruption rejected",
      "measured_modes": [
        "snapshot"
      ],
      "cost": "API breaking v0.5; ordinal lookup O(n); snapshot small slowdown, no incremental checkpoint"
    }
  ],
